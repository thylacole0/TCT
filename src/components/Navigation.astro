---
import TctIcon from './icons/TctIcon';

interface Props {
  currentPath: string;
  currentSearch?: string;
}

const { currentPath, currentSearch = '' } = Astro.props;
const normalizedPath = currentPath !== '/' ? currentPath.replace(/\/$/, '') : currentPath;
void currentSearch;

const navItems = [
  { label: 'DASHBOARD', mobileLabel: 'Dash', icon: 'home', href: '/', path: '/', match: 'exact' },
  { label: 'PESO', mobileLabel: 'Peso', icon: 'scale', href: '/peso', path: '/peso', match: 'prefix' },
  { label: 'FINANZAS', mobileLabel: 'Finanzas', icon: 'wallet', href: '/finanzas', path: '/finanzas', match: 'prefix' },
  { label: 'PERSONAL', mobileLabel: 'Personal', icon: 'userWallet', href: '/finanzas/personales', path: '/finanzas/personales', match: 'prefix' },
  { label: 'COMIDAS', mobileLabel: 'Comidas', icon: 'utensils', href: '/comidas', path: '/comidas', match: 'prefix' },
  { label: 'LISTA', mobileLabel: 'Lista', icon: 'list', href: '/lista', path: '/lista', match: 'prefix' },
  { label: 'CONFIG', mobileLabel: 'Config', icon: 'settings', href: '/config', path: '/config', match: 'prefix' },
];

const activePath = navItems
  .filter((item) => {
    if (item.match === 'exact') return normalizedPath === item.path;
    return normalizedPath === item.path || normalizedPath.startsWith(item.path + '/');
  })
  .sort((a, b) => b.path.length - a.path.length)[0]?.path;

function isItemActive(item: typeof navItems[0]) {
  return item.path === activePath;
}
---

<nav class="nav">
  <div class="nav-inner">
    <div class="nav-brand">
      <span class="brand-dot"></span>
      <span class="brand-text">TCT</span>
    </div>
    <div class="nav-links">
      {navItems.map((item) => {
        const isActive = isItemActive(item);
        return (
          <a
            href={item.href}
            class:list={['nav-link', { active: isActive }]}
            aria-current={isActive ? 'page' : undefined}
          >
            {isActive ? `[ ${item.label} ]` : item.label}
          </a>
        );
      })}
    </div>
    <div class="nav-actions">
      <button id="theme-toggle" class="theme-btn" aria-label="Toggle theme">
        <span class="theme-icon"><TctIcon name="theme" size={16} variant="dots" /></span>
      </button>
      <a href="/api/auth/signout" class="nav-link signout">SALIR</a>
    </div>
  </div>
</nav>

<!-- Mobile bottom nav -->
<nav class="nav-mobile" aria-label="Navegación principal">
  {navItems.map((item) => {
    const isActive = isItemActive(item);
    return (
      <a
        href={item.href}
        class:list={['nav-mobile-link', { active: isActive }]}
        aria-current={isActive ? 'page' : undefined}
        aria-label={item.label}
      >
        <span class="nav-mobile-icon" aria-hidden="true">
          <TctIcon name={item.icon} size={18} variant="dots" />
        </span>
        <span class="nav-mobile-label">{item.mobileLabel}</span>
        {isActive && <span class="nav-mobile-dot"></span>}
      </a>
    );
  })}
</nav>

<script>
  function initTheme() {
    const toggle = document.getElementById('theme-toggle');
    const html = document.documentElement;
    
    // Load saved theme
    const saved = localStorage.getItem('tct-theme');
    if (saved) html.setAttribute('data-theme', saved);
    
    toggle?.addEventListener('click', () => {
      const current = html.getAttribute('data-theme');
      const next = current === 'light' ? 'dark' : 'light';
      html.setAttribute('data-theme', next);
      localStorage.setItem('tct-theme', next);
    });
  }

  // Run on initial load and after view transitions
  initTheme();
  document.addEventListener('astro:after-swap', initTheme);
</script>

<style>
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    background: var(--black);
    border-bottom: 1px solid var(--border);
    height: calc(56px + env(safe-area-inset-top, 0px));
    padding-top: env(safe-area-inset-top, 0px);
  }

  .nav-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 var(--space-lg);
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-xl);
  }

  .nav-brand {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
  }

  .brand-dot {
    width: 8px;
    height: 8px;
    background: var(--accent);
    border-radius: 50%;
  }

  .brand-text {
    font-family: var(--font-mono);
    font-size: var(--body);
    font-weight: 700;
    color: var(--text-display);
    letter-spacing: 0.1em;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: var(--space-lg);
  }

  .nav-link {
    font-family: var(--font-mono);
    font-size: var(--label);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-disabled);
    text-decoration: none;
    padding: var(--space-sm) 0;
    transition: color var(--duration-micro) var(--ease-out);
    white-space: nowrap;
  }

  .nav-link:hover {
    color: var(--text-primary);
  }

  .nav-link.active {
    color: var(--text-display);
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: var(--space-md);
  }

  .theme-btn {
    background: none;
    border: none;
    cursor: pointer;
    padding: var(--space-xs);
    color: var(--text-secondary);
    font-size: 18px;
    transition: color var(--duration-micro) var(--ease-out);
    line-height: 1;
  }

  .theme-btn:hover {
    color: var(--text-display);
  }

  .theme-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .signout {
    color: var(--text-disabled);
    font-size: var(--label);
  }

  .signout:hover {
    color: var(--accent);
  }

  /* Mobile bottom nav */
  .nav-mobile {
    display: none;
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 100;
    background: var(--black);
    border-top: 1px solid var(--border);
    height: calc(66px + env(safe-area-inset-bottom, 0px));
    padding-bottom: env(safe-area-inset-bottom, 0px);
    justify-content: stretch;
    align-items: stretch;
  }

  .nav-mobile-link {
    color: var(--text-disabled);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 3px;
    text-decoration: none;
    flex: 1 1 0;
    min-width: 0;
    min-height: 66px;
    padding: 6px 2px 8px;
    -webkit-tap-highlight-color: transparent;
    touch-action: manipulation;
    cursor: pointer;
    position: relative;
    transition: color var(--duration-micro) var(--ease-out), background var(--duration-micro) var(--ease-out);
  }

  .nav-mobile-link:active {
    background: var(--surface-raised);
  }

  .nav-mobile-icon {
    color: currentColor;
    display: flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
    pointer-events: none;
  }

  .nav-mobile-icon svg {
    display: block;
  }

  .nav-mobile-label {
    color: currentColor;
    font-family: var(--font-mono);
    font-size: 7.8px;
    letter-spacing: 0.015em;
    line-height: 1;
    max-width: 100%;
    overflow: hidden;
    pointer-events: none;
    text-align: center;
    text-overflow: ellipsis;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .nav-mobile-link.active {
    color: var(--text-display);
  }

  .nav-mobile-dot {
    width: 4px;
    height: 4px;
    background: currentColor;
    border-radius: 50%;
    pointer-events: none;
    position: absolute;
    bottom: calc(5px + env(safe-area-inset-bottom, 0px));
    left: 50%;
    transform: translateX(-50%);
  }

  @media (max-width: 768px) {
    .nav {
      height: calc(48px + env(safe-area-inset-top, 0px));
    }
    .nav-links {
      display: none;
    }
    .nav-mobile {
      display: flex;
    }
  }
</style>
