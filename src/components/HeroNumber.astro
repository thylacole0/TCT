---
interface Props {
  value: string | number;
  unit?: string;
  label?: string;
  color?: string;
  size?: 'xl' | 'lg' | 'md';
}

const { value, unit, label, color = 'var(--text-display)', size = 'lg' } = Astro.props;

const sizeMap = {
  xl: 'var(--display-xl)',
  lg: 'var(--display-lg)',
  md: 'var(--display-md)',
};
---

<div class="hero-number">
  {label && <span class="hero-label">{label}</span>}
  <div class="hero-value-wrap">
    <span class="hero-value" style={`font-size: ${sizeMap[size]}; color: ${color};`}>
      {value}
    </span>
    {unit && <span class="hero-unit">{unit}</span>}
  </div>
</div>

<style>
  .hero-number {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .hero-label {
    font-family: var(--font-mono);
    font-size: var(--label);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-secondary);
  }

  .hero-value-wrap {
    display: flex;
    align-items: baseline;
    gap: var(--space-sm);
  }

  .hero-value {
    font-family: var(--font-display);
    font-weight: 400;
    line-height: 1.0;
    letter-spacing: -0.03em;
  }

  .hero-unit {
    font-family: var(--font-mono);
    font-size: var(--label);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-secondary);
    align-self: flex-start;
    margin-top: 0.2em;
  }
</style>
