---
interface Props {
  title?: string;
  description?: string;
  showNav?: boolean;
  currentPath?: string;
}

import Navigation from '../components/Navigation.astro';
import { ClientRouter } from 'astro:transitions';

const { 
  title = 'TCT — Tu Casa Tracker', 
  description = 'Gestiona tu peso, finanzas y comidas del hogar',
  showNav = true,
  currentPath = Astro.url.pathname,
} = Astro.props;
---

<!doctype html>
<html lang="es" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    <!-- Apply saved theme before first paint (also covers pages without nav, e.g. signin) -->
    <script is:inline>
      (function () {
        function applySavedTheme() {
          try {
            var saved = localStorage.getItem('tct-theme');
            if (saved) document.documentElement.setAttribute('data-theme', saved);
          } catch (e) {
            // localStorage unavailable — keep server default
          }
        }
        applySavedTheme();
        document.addEventListener('astro:after-swap', applySavedTheme);
      })();
    </script>

    <!-- Fonts preconnect -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- PWA -->
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#000000" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="TCT" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />

    <ClientRouter />
  </head>
  <body>
    <!-- Push notification opt-in banner -->
    <div id="push-banner" class="push-banner" aria-hidden="true">
      <span class="push-banner-text">¿Activar notificaciones de TCT?</span>
      <div class="push-banner-actions">
        <button id="push-accept" class="push-btn push-btn-accept">ACTIVAR</button>
        <button id="push-dismiss" class="push-btn push-btn-dismiss">NO</button>
      </div>
    </div>
    <!-- Page transition loader -->
    <div id="page-loader" class="page-loader" aria-hidden="true" transition:persist>
      <div class="page-loader-inner">
        <div class="page-loader-dot"></div>
      </div>
    </div>
    {showNav && <Navigation currentPath={currentPath} currentSearch={Astro.url.search} />}
    <main class:list={[{ 'has-nav': showNav }]}>
      <slot />
    </main>
  </body>
</html>

<style is:global>
  @import '../styles/nothing-tokens.css';
  @import '../styles/islands.css';

  /* Ensure islands take full width */
  astro-island {
    display: contents;
  }

  /* Push notification banner */
  .push-banner {
    position: fixed;
    bottom: calc(var(--nav-height-bottom) + env(safe-area-inset-bottom, 0px) + var(--space-md));
    left: var(--space-md);
    right: var(--space-md);
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm);
    padding: var(--space-sm) var(--space-md);
    background: var(--surface-raised);
    border: 1px solid var(--border);
    border-radius: 14px;
    transform: translateY(calc(100% + 80px));
    opacity: 0;
    transition: transform 0.3s ease, opacity 0.3s ease;
    pointer-events: none;
  }
  .push-banner-show {
    transform: translateY(0);
    opacity: 1;
    pointer-events: auto;
  }
  .push-banner-text {
    font-family: var(--font-mono);
    font-size: var(--caption);
    color: var(--text-primary);
    letter-spacing: 0.04em;
  }
  .push-banner-actions {
    display: flex;
    gap: var(--space-xs);
    flex-shrink: 0;
  }
  .push-btn {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    padding: var(--space-xs) var(--space-sm);
    min-height: 44px;
    border: 1px solid var(--border);
    border-radius: 8px;
    cursor: pointer;
    background: transparent;
    color: var(--text-secondary);
    transition: background 0.15s, color 0.15s;
  }
  .push-btn-accept {
    background: var(--text-display);
    color: var(--bg);
    border-color: var(--text-display);
  }
  .push-btn-dismiss:hover {
    background: var(--surface);
  }

  /* --- View Transition Animations --- */
  @keyframes fadeSlideIn {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes fadeSlideOut {
    from {
      opacity: 1;
      transform: translateY(0);
    }
    to {
      opacity: 0;
      transform: translateY(-4px);
    }
  }

  ::view-transition-old(root) {
    animation: fadeSlideOut 150ms var(--ease-out) forwards;
  }

  ::view-transition-new(root) {
    animation: fadeSlideIn 200ms var(--ease-out) forwards;
  }

  /* Keep nav stable during transitions */
  .nav, .nav-mobile {
    view-transition-name: nav;
  }

  ::view-transition-old(nav),
  ::view-transition-new(nav) {
    animation: none;
    mix-blend-mode: normal;
  }

  /* Page transition loader — full body overlay */
  .page-loader {
    position: fixed;
    inset: 0;
    z-index: 9999;
    background: var(--black);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity 100ms ease-out;
  }

  .page-loader.active {
    opacity: 1;
    pointer-events: auto;
  }

  .page-loader.done {
    opacity: 0;
    transition: opacity 200ms ease-out;
    pointer-events: none;
  }

  .page-loader-inner {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .page-loader-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--text-display);
    animation: loaderPulse 800ms ease-in-out infinite;
  }

  @keyframes loaderPulse {
    0%, 100% { opacity: 0.2; transform: scale(1); }
    50% { opacity: 1; transform: scale(1.8); }
  }
</style>

<style>
  main {
    max-width: 1200px;
    margin: 0 auto;
    padding: var(--space-lg);
    min-height: 100vh;
  }

  main.has-nav {
    padding-top: calc(56px + env(safe-area-inset-top, 0px) + var(--space-xl));
  }

  @media (max-width: 768px) {
    main {
      padding: var(--space-md);
    }
    main.has-nav {
      padding-top: calc(48px + env(safe-area-inset-top, 0px) + var(--space-lg));
      padding-bottom: calc(var(--nav-height-bottom) + env(safe-area-inset-bottom, 0px) + var(--space-lg));
    }
  }
</style>

<script>
  function initLoader() {
    const loader = document.getElementById('page-loader');
    if (!loader) return;

    let safetyTimer: ReturnType<typeof setTimeout> | undefined;

    const hideLoader = () => {
      if (safetyTimer) clearTimeout(safetyTimer);
      loader.classList.remove('active');
      loader.classList.add('done');
      setTimeout(() => loader.classList.remove('done'), 250);
    };

    // Show loader instantly on internal link click (before Astro starts fetching)
    document.addEventListener('click', (e) => {
      // Modified clicks / non-primary button open in another tab: the swap never
      // happens here, so the loader would stay stuck covering the page
      if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || (e as MouseEvent).button !== 0) return;
      const link = (e.target as Element)?.closest?.('a[href]') as HTMLAnchorElement | null;
      if (!link) return;
      if (link.target === '_blank' || link.hasAttribute('download')) return;
      const href = link.getAttribute('href');
      if (!href || href.startsWith('http') || href.startsWith('#') || href.startsWith('mailto:') || href.startsWith('tel:') || link.hasAttribute('data-astro-reload')) return;
      // Same page — skip
      if (href === window.location.pathname) return;
      loader.classList.remove('done');
      loader.classList.add('active');
      // Safety net: never leave the overlay blocking the app if navigation fails
      if (safetyTimer) clearTimeout(safetyTimer);
      safetyTimer = setTimeout(hideLoader, 8000);
    });

    document.addEventListener('astro:after-swap', hideLoader);
  }
  initLoader();

  // Register service worker & push notifications
  if ('serviceWorker' in navigator) {
    navigator.serviceWorker.register('/sw.js', { scope: '/' }).then(async (reg) => {
      // Check if push notifications are supported and not yet subscribed
      if (!('PushManager' in window) || !('Notification' in window)) return;
      if (Notification.permission === 'granted') {
        await ensurePushSubscription(reg);
        return;
      }
      if (Notification.permission === 'denied') return;

      // Show the notification banner after a short delay
      if (!localStorage.getItem('tct-push-dismissed')) {
        setTimeout(() => {
          const banner = document.getElementById('push-banner');
          if (banner) {
            banner.classList.add('push-banner-show');
            banner.setAttribute('aria-hidden', 'false');
          }
        }, 2000);
      }
    }).catch((err) => {
      console.warn('SW registration failed:', err);
    });
  }

  // Handle notification banner buttons
  document.getElementById('push-accept')?.addEventListener('click', async () => {
    const banner = document.getElementById('push-banner');
    if (banner) {
      banner.classList.remove('push-banner-show');
      banner.setAttribute('aria-hidden', 'true');
    }
    localStorage.removeItem('tct-push-dismissed');
    const permission = await Notification.requestPermission();
    if (permission === 'granted') {
      const reg = await navigator.serviceWorker.ready;
      await ensurePushSubscription(reg);
    }
  });
  document.getElementById('push-dismiss')?.addEventListener('click', () => {
    const banner = document.getElementById('push-banner');
    if (banner) {
      banner.classList.remove('push-banner-show');
      banner.setAttribute('aria-hidden', 'true');
    }
    localStorage.setItem('tct-push-dismissed', '1');
  });

  async function ensurePushSubscription(reg: ServiceWorkerRegistration): Promise<{ ok: boolean; status: string; error?: string }> {
    try {
      let sub = await reg.pushManager.getSubscription();

      if (!sub) {
        const res = await fetch('/api/push/vapid-key');
        if (!res.ok) {
          const message = await res.text().catch(() => 'VAPID key not configured');
          return { ok: false, status: 'vapid_error', error: message };
        }
        const { publicKey } = await res.json();
        if (!publicKey) return { ok: false, status: 'vapid_error', error: 'VAPID public key vacío' };

        const applicationServerKey = urlBase64ToUint8Array(publicKey);
        sub = await reg.pushManager.subscribe({
          userVisibleOnly: true,
          applicationServerKey,
        });
      }

      const saveRes = await fetch('/api/push/subscribe', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ subscription: sub.toJSON() }),
      });
      if (!saveRes.ok) {
        const message = await saveRes.text().catch(() => 'subscription_save_failed');
        return { ok: false, status: 'save_failed', error: message };
      }
      return { ok: true, status: 'enabled' };
    } catch (err) {
      console.warn('Push subscription failed:', err);
      const message = err instanceof Error ? err.message : 'push_subscription_failed';
      return { ok: false, status: 'failed', error: message };
    }
  }

  (window as any).tctEnablePush = async () => {
    if (!('serviceWorker' in navigator) || !('PushManager' in window) || !('Notification' in window)) {
      return { ok: false, status: 'unsupported' };
    }
    const permission = Notification.permission === 'granted'
      ? 'granted'
      : await Notification.requestPermission();
    if (permission !== 'granted') {
      return { ok: false, status: permission };
    }
    localStorage.removeItem('tct-push-dismissed');
    const reg = await navigator.serviceWorker.ready;
    return ensurePushSubscription(reg);
  };

  function urlBase64ToUint8Array(base64String: string) {
    const padding = '='.repeat((4 - (base64String.length % 4)) % 4);
    const base64 = (base64String + padding).replace(/-/g, '+').replace(/_/g, '/');
    const raw = atob(base64);
    const arr = new Uint8Array(raw.length);
    for (let i = 0; i < raw.length; ++i) arr[i] = raw.charCodeAt(i);
    return arr;
  }
</script>
