---
import Layout from '../../layouts/Layout.astro';
import Card from '../../components/Card.astro';
import Button from '../../components/Button.astro';
import Input from '../../components/Input.astro';
import { createAuthClient } from '../../lib/supabase';

const { user, accessToken } = Astro.locals;
if (!user || !accessToken) return Astro.redirect('/signin');

const supabase = createAuthClient(accessToken);

// Parallel fetch
const [profilesRes] = await Promise.all([
  supabase.from('profiles').select('*'),
]);

const profiles = profilesRes.data;
// Handle form submissions
if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData();
  const action = formData.get('action')?.toString();

  if (action === 'update_profile') {
    const displayName = formData.get('display_name')?.toString().trim();
    if (!displayName) {
      return Astro.redirect('/config?error=empty');
    }
    if ((await supabase.from('profiles').update({ display_name: displayName }).eq('id', user.id)).error) {
      return Astro.redirect('/config?error=save');
    }
    return Astro.redirect('/config?saved=1');
  }

  return Astro.redirect('/config');
}

const myProfile = profiles?.find(p => p.id === user.id);

// Post-redirect feedback
const saved = Astro.url.searchParams.get('saved') === '1';
const errorParam = Astro.url.searchParams.get('error');
const saveErrorMsg =
  errorParam === 'empty'
    ? 'El nombre no puede estar vacío.'
    : errorParam === 'save'
      ? 'No se pudo guardar el perfil. Intenta de nuevo.'
      : null;
---

<Layout title="TCT — Configuración" currentPath="/config">
  <div class="config-page">
    <h2 class="page-title">CONFIGURACIÓN</h2>

    <!-- PROFILE -->
    <section class="config-section">
      <span class="label">PERFIL</span>
      <Card padding="md">
        <div class="profile-avatar-section">
          {(myProfile as any)?.avatar_url ? (
            <img src={(myProfile as any).avatar_url} alt="" width="48" height="48" class="profile-avatar" />
          ) : (
            <span class="profile-avatar-letter">{(myProfile?.display_name || '?')[0]}</span>
          )}
        </div>
        {saved && <p class="config-feedback config-feedback-ok" role="status">[PERFIL GUARDADO]</p>}
        {saveErrorMsg && <p class="config-feedback config-feedback-error" role="alert">[{saveErrorMsg}]</p>}
        <form method="POST" class="profile-form">
          <input type="hidden" name="action" value="update_profile" />
          <div class="profile-row">
            <Input label="Nombre para mostrar" name="display_name" value={myProfile?.display_name || ''} required />
            <Button type="submit" variant="secondary">GUARDAR</Button>
          </div>
        </form>
        <div class="profile-info">
          <span class="caption">{user.email}</span>
        </div>
      </Card>
    </section>

    <!-- THEME -->
    <section class="config-section">
      <span class="label">APARIENCIA</span>
      <Card padding="md">
        <div class="theme-row">
          <span class="theme-label">Modo oscuro</span>
          <button id="config-theme-toggle" class="theme-toggle-btn">
            <span class="toggle-track">
              <span class="toggle-thumb"></span>
            </span>
          </button>
        </div>
      </Card>
    </section>

    <!-- NOTIFICATIONS -->
    <section class="config-section">
      <span class="label">NOTIFICACIONES</span>
      <Card padding="md">
        <div class="notification-row">
          <div class="notification-copy">
            <span class="notification-title">Recordatorios PWA</span>
            <span id="config-push-status" class="caption">Revisando estado...</span>
          </div>
          <button id="config-push-enable" class="notification-btn" type="button">
            ACTIVAR
          </button>
        </div>
      </Card>
    </section>

    <!-- CICLO DE FACTURACIÓN -->
    <section class="config-section">
      <span class="label">CICLO DE FACTURACIÓN</span>
      <Card padding="md">
        <div class="billing-row">
          <div class="billing-copy">
            <span class="billing-title">Día de inicio del mes</span>
            <span class="caption">Define cuándo empieza tu mes financiero. Ej: si tu tarjeta factura el 20, el ciclo empieza el 21.</span>
          </div>
        </div>
        <div class="billing-control">
          <div class="billing-input-group">
            <span class="billing-input-label">DÍA</span>
            <input
              id="config-billing-day"
              type="number"
              min="1"
              max="28"
              class="billing-input"
              placeholder="1"
            />
          </div>
          <span class="billing-preview" id="config-billing-preview">CICLO: 1-31</span>
        </div>
        <div id="config-billing-feedback" class="config-feedback" style="display:none"></div>
        <div class="billing-actions">
          <button id="config-billing-save" class="billing-save-btn" type="button" disabled>GUARDAR</button>
        </div>
      </Card>
    </section>
  </div>
</Layout>

<script>
  const toggle = document.getElementById('config-theme-toggle');
  const html = document.documentElement;
  
  function updateToggle() {
    const isDark = html.getAttribute('data-theme') !== 'light';
    const thumb = toggle?.querySelector('.toggle-thumb') as HTMLElement;
    const track = toggle?.querySelector('.toggle-track') as HTMLElement;
    if (thumb && track) {
      thumb.style.transform = isDark ? 'translateX(20px)' : 'translateX(0)';
      track.style.background = isDark ? 'var(--text-display)' : 'var(--border-visible)';
      thumb.style.background = isDark ? 'var(--black)' : 'var(--text-disabled)';
    }
  }
  
  updateToggle();
  
  toggle?.addEventListener('click', () => {
    const current = html.getAttribute('data-theme');
    const next = current === 'light' ? 'dark' : 'light';
    html.setAttribute('data-theme', next);
    localStorage.setItem('tct-theme', next);
    updateToggle();
  });

  const pushBtn = document.getElementById('config-push-enable') as HTMLButtonElement | null;
  const pushStatus = document.getElementById('config-push-status');

  function updatePushStatus(message?: string) {
    if (!pushStatus || !pushBtn) return;
    if (!('Notification' in window) || !('PushManager' in window)) {
      pushStatus.textContent = 'Este dispositivo no soporta Web Push';
      pushBtn.disabled = true;
      return;
    }
    if (message) {
      pushStatus.textContent = message;
      return;
    }
    if (Notification.permission === 'granted') {
      pushStatus.textContent = 'Activas para este dispositivo';
      pushBtn.textContent = 'REACTIVAR';
    } else if (Notification.permission === 'denied') {
      pushStatus.textContent = 'Bloqueadas en el navegador';
      pushBtn.disabled = true;
    } else {
      pushStatus.textContent = 'Pendientes de activar';
    }
  }

  updatePushStatus();

  pushBtn?.addEventListener('click', async () => {
    pushBtn.disabled = true;
    updatePushStatus('Activando...');
    const result = await (window as any).tctEnablePush?.();
    if (result?.ok) {
      updatePushStatus('Activas para este dispositivo');
      pushBtn.textContent = 'REACTIVAR';
    } else if (result?.status === 'denied') {
      updatePushStatus('Bloqueadas en el navegador');
    } else if (result?.status === 'unsupported') {
      updatePushStatus('Este dispositivo no soporta Web Push');
    } else {
      updatePushStatus('No se pudo activar. Intenta nuevamente.');
    }
    pushBtn.disabled = false;
  });

  // ─── Billing cycle ───
  const billingInput = document.getElementById('config-billing-day') as HTMLInputElement | null;
  const billingPreview = document.getElementById('config-billing-preview');
  const billingSave = document.getElementById('config-billing-save') as HTMLButtonElement | null;
  const billingFeedback = document.getElementById('config-billing-feedback');
  let billingCurrentValue = 1;

  function updateBillingPreview(day: number) {
    if (!billingPreview) return;
    const end = day > 1 ? day - 1 : 31;
    const label = day > 1 ? `CICLO: ${day}-${end}` : 'CICLO: 1-31';
    billingPreview.textContent = label;
  }

  async function loadBillingDay() {
    try {
      const res = await fetch('/api/profile/billing-start-day');
      if (!res.ok) return;
      const json = await res.json();
      billingCurrentValue = json.billing_start_day ?? 1;
      if (billingInput) {
        billingInput.value = String(billingCurrentValue);
      }
      updateBillingPreview(billingCurrentValue);
    } catch {
      // ignore
    }
  }

  billingInput?.addEventListener('input', () => {
    const raw = parseInt(billingInput.value, 10);
    const day = Number.isFinite(raw) ? raw : 1;
    updateBillingPreview(day);
    const changed = day !== billingCurrentValue;
    if (billingSave) billingSave.disabled = !changed || !(day >= 1 && day <= 28);
  });

  billingSave?.addEventListener('click', async () => {
    if (!billingInput || !billingSave || !billingFeedback) return;
    const raw = parseInt(billingInput.value, 10);
    const day = Number.isFinite(raw) ? raw : 1;
    if (day < 1 || day > 28) return;

    billingSave.disabled = true;
    billingSave.textContent = 'GUARDANDO...';
    billingFeedback.style.display = 'none';

    try {
      const res = await fetch('/api/profile/billing-start-day', {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ billing_start_day: day }),
      });
      if (!res.ok) {
        const json = await res.json().catch(() => null);
        billingFeedback.textContent = `[${json?.error || 'ERROR AL GUARDAR'}]`;
        billingFeedback.className = 'config-feedback config-feedback-error';
        billingFeedback.style.display = 'block';
        return;
      }
      billingCurrentValue = day;
      billingFeedback.textContent = '[CICLO ACTUALIZADO]';
      billingFeedback.className = 'config-feedback config-feedback-ok';
      billingFeedback.style.display = 'block';
      billingSave.disabled = true;
    } catch {
      billingFeedback.textContent = '[ERROR DE CONEXIÓN]';
      billingFeedback.className = 'config-feedback config-feedback-error';
      billingFeedback.style.display = 'block';
    } finally {
      billingSave.textContent = 'GUARDAR';
      billingSave.disabled = true;
    }
  });

  loadBillingDay();
</script>

<style>
  .config-page {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xl);
    max-width: 600px;
  }

  .page-title {
    font-family: var(--font-mono);
    font-size: var(--heading);
    letter-spacing: -0.01em;
    color: var(--text-display);
    font-weight: 400;
  }

  .config-section {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  /* Profile */
  .profile-avatar-section {
    display: flex;
    align-items: center;
    margin-bottom: var(--space-md);
  }

  .profile-avatar {
    border-radius: 50%;
    object-fit: cover;
  }

  .profile-avatar-letter {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: var(--surface);
    color: var(--text-secondary);
    font-size: 22px;
    font-family: var(--font-mono);
  }

  .profile-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .config-feedback {
    font-family: var(--font-mono);
    font-size: var(--caption);
    letter-spacing: 0.04em;
    margin-bottom: var(--space-md);
  }

  .config-feedback-ok {
    color: var(--success);
  }

  .config-feedback-error {
    color: var(--accent);
  }

  .profile-row {
    display: flex;
    align-items: flex-end;
    gap: var(--space-md);
  }

  .profile-row > :first-child {
    flex: 1;
  }

  .profile-info {
    padding-top: var(--space-sm);
  }

  /* Items list */
  .category-block {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .category-title {
    font-family: var(--font-mono);
    font-size: var(--caption);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-disabled);
    padding-top: var(--space-sm);
  }

  .items-list {
    display: flex;
    flex-direction: column;
  }

  .item-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--space-sm) 0;
    border-bottom: 1px solid var(--border);
  }

  .item-info {
    display: flex;
    align-items: center;
    gap: var(--space-md);
  }

  .item-name {
    font-family: var(--font-body);
    font-size: var(--body-sm);
    color: var(--text-primary);
  }

  .item-points {
    font-family: var(--font-mono);
    font-size: var(--label);
    letter-spacing: 0.06em;
    color: var(--text-secondary);
  }

  .delete-form {
    display: contents;
  }

  .delete-btn {
    background: none;
    border: none;
    color: var(--text-disabled);
    font-size: 18px;
    cursor: pointer;
    padding: var(--space-xs);
    transition: color var(--duration-micro) var(--ease-out);
    line-height: 1;
  }

  .delete-btn:hover {
    color: var(--accent);
  }

  /* Add form */
  .add-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .form-title {
    font-family: var(--font-mono);
    font-size: var(--label);
    letter-spacing: 0.08em;
    color: var(--text-secondary);
  }

  .add-fields {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .input-group {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .input-label {
    font-family: var(--font-mono);
    font-size: var(--label);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-secondary);
  }

  .select-field {
    font-family: var(--font-mono);
    font-size: var(--body-sm);
    color: var(--text-primary);
    background: transparent;
    border: none;
    border-bottom: 1px solid var(--border-visible);
    padding: var(--space-sm) 0;
    outline: none;
    appearance: none;
    cursor: pointer;
  }

  .select-field option {
    background: var(--surface);
    color: var(--text-primary);
  }

  /* Theme toggle */
  .theme-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .theme-label {
    font-family: var(--font-body);
    font-size: var(--body-sm);
    color: var(--text-primary);
  }

  .theme-toggle-btn {
    background: none;
    border: none;
    cursor: pointer;
    padding: var(--space-xs);
  }

  .toggle-track {
    display: block;
    width: 44px;
    height: 24px;
    border-radius: 12px;
    background: var(--text-display);
    position: relative;
    transition: background var(--duration-micro) var(--ease-out);
  }

  .toggle-thumb {
    display: block;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: var(--black);
    position: absolute;
    top: 2px;
    left: 2px;
    transition: transform var(--duration-normal) var(--ease-out),
                background var(--duration-normal) var(--ease-out);
  }

  /* Notifications */
  .notification-row {
    align-items: center;
    display: flex;
    gap: var(--space-md);
    justify-content: space-between;
  }

  .notification-copy {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
  }

  .notification-title {
    color: var(--text-primary);
    font-family: var(--font-body);
    font-size: var(--body-sm);
  }

  .notification-btn {
    background: transparent;
    border: 1px solid var(--border-visible);
    border-radius: var(--radius-technical);
    color: var(--text-primary);
    cursor: pointer;
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.08em;
    padding: var(--space-xs) var(--space-md);
    transition: border-color var(--duration-micro) var(--ease-out),
                color var(--duration-micro) var(--ease-out);
  }

  .notification-btn:hover:not(:disabled) {
    border-color: var(--text-display);
    color: var(--text-display);
  }

  .notification-btn:disabled {
    cursor: default;
    opacity: 0.45;
  }

  /* Billing cycle */
  .billing-row {
    align-items: flex-start;
    display: flex;
    gap: var(--space-md);
    margin-bottom: var(--space-md);
  }

  .billing-copy {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
  }

  .billing-title {
    color: var(--text-primary);
    font-family: var(--font-body);
    font-size: var(--body-sm);
  }

  .billing-control {
    align-items: flex-end;
    display: flex;
    gap: var(--space-lg);
    margin-bottom: var(--space-md);
  }

  .billing-input-group {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
  }

  .billing-input-label {
    color: var(--text-secondary);
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.08em;
  }

  .billing-input {
    background: var(--surface);
    border: 1px solid var(--border-visible);
    border-radius: var(--radius-technical);
    color: var(--text-display);
    font-family: var(--font-mono);
    font-size: var(--body);
    max-width: 80px;
    padding: var(--space-sm) var(--space-md);
    text-align: center;
  }

  .billing-input:focus {
    border-color: var(--text-display);
    outline: none;
  }

  .billing-preview {
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: var(--caption);
    letter-spacing: 0.06em;
    padding-bottom: 2px;
  }

  .billing-actions {
    display: flex;
    justify-content: flex-end;
    margin-top: var(--space-md);
  }

  .billing-save-btn {
    background: var(--text-display);
    border: 1px solid var(--text-display);
    border-radius: var(--radius-technical);
    color: var(--black);
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.08em;
    padding: var(--space-xs) var(--space-md);
    text-transform: uppercase;
    transition: opacity var(--duration-micro) var(--ease-out);
  }

  .billing-save-btn:hover:not(:disabled) {
    opacity: 0.85;
  }

  .billing-save-btn:disabled {
    cursor: default;
    opacity: 0.35;
  }
</style>
