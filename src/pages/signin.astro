---
import Layout from '../layouts/Layout.astro';

// If already logged in, redirect to dashboard
const { user } = Astro.locals;
if (user) {
  return Astro.redirect('/');
}
---

<Layout title="TCT — Iniciar Sesión" showNav={false}>
  <div class="signin-container">
    <div class="signin-card">
      <!-- Brand -->
      <div class="brand">
        <span class="brand-dot"></span>
        <h1 class="brand-name">TCT</h1>
      </div>
      <p class="brand-tagline">TU CASA TRACKER</p>
      
      <!-- Dot grid decoration -->
      <div class="dot-decoration dot-grid-subtle"></div>

      <!-- Google Sign In -->
      <form action="/api/auth/signin" method="post" class="signin-form" data-astro-reload>
        <button type="submit" name="provider" value="google" class="btn-google">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
            <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 01-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z" fill="#4285F4"/>
            <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
            <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
            <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
          </svg>
          <span>CONTINUAR CON GOOGLE</span>
        </button>
      </form>

      <!-- Divider -->
      <div class="divider">
        <span class="divider-line"></span>
        <span class="divider-text">O</span>
        <span class="divider-line"></span>
      </div>

      <!-- Email/Password Sign In -->
      <form action="/api/auth/signin" method="post" class="signin-form" data-astro-reload>
        <div class="input-group">
          <label for="email" class="input-label">EMAIL</label>
          <input type="email" id="email" name="email" class="input-field" required />
        </div>
        <div class="input-group">
          <label for="password" class="input-label">PASSWORD</label>
          <input type="password" id="password" name="password" class="input-field" required />
        </div>
        <button type="submit" class="btn-submit">INGRESAR</button>
      </form>
    </div>

    <!-- Footer -->
    <p class="footer-text">PESO · FINANZAS · COMIDAS</p>
  </div>
</Layout>

<style>
  .signin-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 100vh;
    padding: var(--space-lg);
    gap: var(--space-2xl);
  }

  .signin-card {
    width: 100%;
    max-width: 380px;
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: var(--space-md);
  }

  .brand-dot {
    width: 12px;
    height: 12px;
    background: var(--accent);
    border-radius: 50%;
    flex-shrink: 0;
  }

  .brand-name {
    font-family: var(--font-display);
    font-size: var(--display-lg);
    color: var(--text-display);
    letter-spacing: -0.02em;
    line-height: 1;
    font-weight: 400;
  }

  .brand-tagline {
    font-family: var(--font-mono);
    font-size: var(--label);
    letter-spacing: 0.15em;
    color: var(--text-disabled);
    text-transform: uppercase;
  }

  .dot-decoration {
    height: 48px;
    opacity: 0.3;
    border-radius: var(--radius-compact);
  }

  .signin-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .btn-google {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-sm);
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-primary);
    background: transparent;
    border: 1px solid var(--border-visible);
    border-radius: var(--radius-pill);
    padding: 14px 24px;
    min-height: 48px;
    cursor: pointer;
    transition: all var(--duration-micro) var(--ease-out);
  }

  .btn-google:hover {
    border-color: var(--text-primary);
    color: var(--text-display);
  }

  .divider {
    display: flex;
    align-items: center;
    gap: var(--space-md);
  }

  .divider-line {
    flex: 1;
    height: 1px;
    background: var(--border);
  }

  .divider-text {
    font-family: var(--font-mono);
    font-size: var(--label);
    color: var(--text-disabled);
    letter-spacing: 0.1em;
  }

  .input-group {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .input-label {
    font-family: var(--font-mono);
    font-size: var(--label);
    letter-spacing: 0.08em;
    color: var(--text-secondary);
  }

  .input-field {
    font-family: var(--font-mono);
    font-size: var(--body-sm);
    color: var(--text-primary);
    background: transparent;
    border: none;
    border-bottom: 1px solid var(--border-visible);
    padding: var(--space-sm) 0;
    outline: none;
    transition: border-color var(--duration-micro) var(--ease-out);
  }

  .input-field:focus {
    border-bottom-color: var(--text-primary);
  }

  .btn-submit {
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--black);
    background: var(--text-display);
    border: none;
    border-radius: var(--radius-pill);
    padding: 14px 24px;
    min-height: 48px;
    cursor: pointer;
    transition: opacity var(--duration-micro) var(--ease-out);
    margin-top: var(--space-sm);
  }

  .btn-submit:hover {
    opacity: 0.9;
  }

  .footer-text {
    font-family: var(--font-mono);
    font-size: var(--label);
    letter-spacing: 0.15em;
    color: var(--text-disabled);
  }
</style>
