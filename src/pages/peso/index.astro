---
import Layout from '../../layouts/Layout.astro';
import WeightIsland from '../../components/islands/WeightIsland';
import { todayChile } from '../../lib/dates';

const { user, accessToken, userRole } = Astro.locals;
if (!user || !accessToken) return Astro.redirect('/signin');

const todayStr = todayChile();
const isReadOnly = userRole === 'admin';
---

<Layout title="TCT — Peso" currentPath="/peso">
  <div class="peso-page">
    <h2 class="page-title">PESO</h2>
    <WeightIsland client:load todayStr={todayStr} isReadOnly={isReadOnly} />
  </div>
</Layout>

<style>
  .peso-page {
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
    max-width: 600px;
  }

  .page-title {
    font-family: var(--font-mono);
    font-size: var(--heading);
    letter-spacing: -0.01em;
    color: var(--text-display);
    font-weight: 400;
  }
</style>
