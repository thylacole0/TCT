---
import Layout from '../layouts/Layout.astro';
import TctIcon from '../components/icons/TctIcon';
import { createAuthClient } from '../lib/supabase';
import { getFreshUserMetadata } from '../lib/userMetadata';
import {
  cycleKeyFromDate,
  formatDateCL,
  formatPersonalCycleLabel,
  getMondayChile,
  getPersonalCycleBounds,
  hourChile,
  normalizePersonalBillingCycle,
  nowChile,
  todayChile,
} from '../lib/dates';

const { user, accessToken } = Astro.locals;
if (!user || !accessToken) return Astro.redirect('/signin');

const supabase = createAuthClient(accessToken);

// Current month boundaries (Chile timezone)
const now = nowChile();
const userMeta = await getFreshUserMetadata(accessToken, user);
const personalBillingCycle = normalizePersonalBillingCycle(
  userMeta.personal_billing_cycle,
  userMeta.billing_start_day
);
const personalCycleKey = cycleKeyFromDate(now, personalBillingCycle);
const personalCycleBounds = getPersonalCycleBounds(personalCycleKey, personalBillingCycle);
const personalMonthStart = `${personalCycleKey}-01`;
const personalPeriodLabel = formatPersonalCycleLabel(personalCycleBounds.from, personalCycleBounds.to);

// Current week budget (Chile timezone)
const weekStart = getMondayChile();
const weekEnd = new Date(weekStart);
weekEnd.setDate(weekStart.getDate() + 6);
const weekStartStr = formatDateCL(weekStart);
const todayStr = todayChile();
const hour = hourChile();
const currentMeal = hour < 10 ? 'Desayuno' : hour < 16 ? 'Almuerzo' : 'Once';
const weekLabel = `${weekStart.toLocaleDateString('es-CL', { day: '2-digit', month: 'short' })} — ${weekEnd.toLocaleDateString('es-CL', { day: '2-digit', month: 'short' })}`.toUpperCase();

// Parallel fetch all independent queries
const [
  profilesRes,
  budgetRes,
  recentExpensesRes,
  todaysMealsRes,
  mealTypesRes,
  weightRes,
  personalSettingsRes,
  personalExpensesRes,
  personalInstallmentsRes,
] = await Promise.all([
  supabase.from('profiles').select('*'),
  supabase.from('budget_weeks').select('*').eq('week_start', weekStartStr).eq('budget_type', 'comida').single(),
  supabase.from('expenses')
    .select('*, profiles(display_name, avatar_url)')
    .order('created_at', { ascending: false })
    .limit(8),
  supabase.from('meal_plans').select('*, meal_types(name)').eq('meal_date', todayStr),
  supabase.from('meal_types').select('*').order('sort_order'),
  supabase.from('weight_logs')
    .select('*')
    .eq('user_id', user.id)
    .order('log_date', { ascending: false })
    .limit(4),
  supabase.from('personal_monthly_settings')
    .select('monthly_income')
    .eq('user_id', user.id)
    .eq('month_start', personalMonthStart)
    .maybeSingle(),
  supabase.from('personal_expenses')
    .select('amount')
    .eq('user_id', user.id)
    .gte('expense_date', personalCycleBounds.from)
    .lte('expense_date', personalCycleBounds.to),
  supabase.from('personal_installments')
    .select('total_amount,total_installments,start_month')
    .eq('user_id', user.id)
    .lte('start_month', personalCycleKey),
]);

const profiles = profilesRes.data;
const currentBudget = budgetRes.data;
const recentExpenses = recentExpensesRes.data || [];
const mealTypes = mealTypesRes.data || [];
const recentWeightLogs = weightRes.data || [];

// Distinguish real failures from "no rows" (PGRST116 is .single() with 0 rows)
const budgetError = !!(budgetRes.error && budgetRes.error.code !== 'PGRST116');
const expensesError = !!recentExpensesRes.error;
const mealsError = !!(todaysMealsRes.error || mealTypesRes.error);
const weightError = !!weightRes.error;

// Fetch expense items for recent expenses
const expenseIds = recentExpenses.map((e: any) => e.id);
const { data: expenseItems } = expenseIds.length > 0
  ? await supabase.from('expense_items').select('*').in('expense_id', expenseIds)
  : { data: [] };

// Today's meals map
const todaysMeals: Record<string, string> = {};
todaysMealsRes.data?.forEach((m: any) => {
  todaysMeals[m.meal_types?.name] = m.description;
});

// Meal labels
const MEAL_LABELS: Record<string, string> = { Desayuno: 'AM', Almuerzo: 'PM', Once: 'EVE' };

// Week expenses (depends on budget result)
let weekExpenses = 0;
let weekExpensesList: any[] = [];
if (currentBudget) {
  const { data: expenses } = await supabase
    .from('expenses')
    .select('amount, expense_date')
    .eq('budget_week_id', currentBudget.id);
  weekExpenses = expenses?.reduce((sum, e) => sum + Number(e.amount), 0) || 0;
  weekExpensesList = expenses || [];
}

const budgetAmount = currentBudget ? Number(currentBudget.budget_amount) : 0;
const budgetPct = budgetAmount > 0 ? Math.min((weekExpenses / budgetAmount) * 100, 100) : 0;
const budgetOverflow = weekExpenses > budgetAmount;
const remaining = budgetAmount - weekExpenses;
const dailyAvg = budgetAmount > 0 ? Math.round(budgetAmount / 7) : 0;

// Daily spending for sparkline
const dayNames = ['LU', 'MA', 'MI', 'JU', 'VI', 'SA', 'DO'];
const dailySpending: Record<string, number> = {};
dayNames.forEach(d => { dailySpending[d] = 0; });
weekExpensesList.forEach(e => {
  const d = new Date(e.expense_date + 'T12:00:00');
  const dow = d.getDay();
  const dayIdx = dow === 0 ? 6 : dow - 1;
  dailySpending[dayNames[dayIdx]] = (dailySpending[dayNames[dayIdx]] || 0) + Number(e.amount);
});
const maxDaily = Math.max(...Object.values(dailySpending), 1);

// Format CLP
const formatCLP = (n: number) => `$${Math.round(n).toLocaleString('es-CL')}`;

const monthDiff = (fromMonth: string, toMonth: string): number => {
  const [fy, fm] = fromMonth.split('-').map(Number);
  const [ty, tm] = toMonth.split('-').map(Number);
  return (ty - fy) * 12 + (tm - fm);
};

const installmentAmountForMonth = (totalAmount: number, totalInstallments: number, currentInstallment: number): number => {
  const base = Math.floor(totalAmount / totalInstallments);
  return currentInstallment === totalInstallments
    ? base + (totalAmount - base * totalInstallments)
    : base;
};

const personalIncome = personalSettingsRes.error ? 0 : Number(personalSettingsRes.data?.monthly_income || 0);
const personalExpenseTotal = personalExpensesRes.error
  ? 0
  : (personalExpensesRes.data || []).reduce((sum: number, row: any) => sum + Number(row.amount || 0), 0);
const personalInstallmentTotal = personalInstallmentsRes.error
  ? 0
  : (personalInstallmentsRes.data || []).reduce((sum: number, inst: any) => {
    const totalInstallments = Number(inst.total_installments) || 0;
    const totalAmount = Number(inst.total_amount) || 0;
    const elapsed = monthDiff(String(inst.start_month || ''), personalCycleKey);
    if (
      totalInstallments <= 0 ||
      totalAmount <= 0 ||
      !Number.isFinite(elapsed) ||
      elapsed < 0 ||
      elapsed >= totalInstallments
    ) return sum;
    return sum + installmentAmountForMonth(totalAmount, totalInstallments, elapsed + 1);
  }, 0);
const personalSpent = personalExpenseTotal + personalInstallmentTotal;
const personalRemaining = personalIncome - personalSpent;
const personalPctRaw = personalIncome > 0 ? (personalSpent / personalIncome) * 100 : 0;
const personalPct = Math.min(personalPctRaw, 100);
const showPersonalSummary = personalIncome > 0;

// Greeting based on time
const greeting = hour < 12 ? 'Buenos días' : hour < 19 ? 'Buenas tardes' : 'Buenas noches';
const myProfile = profiles?.find(p => p.id === user.id) as any;
const firstName = myProfile?.display_name?.split(' ')[0] || '';
const myAvatar = myProfile?.avatar_url || '';

// Pre-compute segmented bar
const budgetSegs = Array.from({ length: 20 }, (_, i) => {
  const segPct = ((i + 1) / 20) * 100;
  const filled = segPct <= budgetPct;
  const color = budgetOverflow ? 'var(--accent)' : budgetPct > 75 ? 'var(--warning)' : 'var(--text-display)';
  return { filled, color };
});

const personalSegs = Array.from({ length: 20 }, (_, i) => {
  const segPct = ((i + 1) / 20) * 100;
  const filled = segPct <= personalPct;
  const color = personalRemaining < 0 ? 'var(--accent)' : personalPctRaw > 80 ? 'var(--warning)' : 'var(--text-display)';
  return { filled, color };
});

// Today's meal filled count
const filledMeals = mealTypes.filter(mt => todaysMeals[mt.name]).length;

// Weight: latest morning entry for dashboard card
const latestWeightLog = recentWeightLogs.find((l: any) => l.time_of_day === 'morning') || recentWeightLogs[0];
const latestWeight = latestWeightLog ? Number(latestWeightLog.weight_kg) : null;
const todayHasMorning = recentWeightLogs.some((l: any) => l.log_date === todayStr && l.time_of_day === 'morning');
const todayHasNight = recentWeightLogs.some((l: any) => l.log_date === todayStr && l.time_of_day === 'night');

// Serialize recent expenses for activity list
const expenseLogsSerialized = recentExpenses.map((exp: any) => ({
  description: exp.description,
  userName: exp.profiles?.display_name || '',
  userAvatar: exp.profiles?.avatar_url || '',
  amount: Number(exp.amount),
  date: new Date(exp.created_at).toLocaleDateString('es-CL', { day: '2-digit', month: 'short' }),
  items: (expenseItems || [])
    .filter((item: any) => item.expense_id === exp.id)
    .map((item: any) => ({ name: item.name, quantity: item.quantity, unit_price: Number(item.unit_price) })),
}));
---

<Layout title="TCT — Dashboard" currentPath="/">
  <div class="dashboard">
    <!-- GREETING -->
    <div class="dash-greeting">
      <div class="dash-greeting-left">
        {myAvatar ? (
          <img src={myAvatar} alt="" width="32" height="32" class="dash-greeting-avatar" />
        ) : (
          <span class="dash-greeting-avatar-letter">{(firstName || '?')[0]}</span>
        )}
        <div class="dash-greeting-text-wrap">
          <span class="dash-greeting-text">{greeting}, {firstName}</span>
          <span class="dash-greeting-date">{now.toLocaleDateString('es-CL', { weekday: 'long', day: 'numeric', month: 'long' }).toUpperCase()}</span>
        </div>
      </div>
    </div>

    {showPersonalSummary && (
      <div class="dash-card dash-card-personal dot-grid-subtle">
        <div class="dash-card-header">
          <div class="dash-card-label">GASTO PERSONAL</div>
          <span class="dash-week-label">{personalPeriodLabel}</span>
        </div>
        <div class="dash-budget-hero">
          <div class="dash-budget-spent">
            <span class="dash-budget-amount" style={personalRemaining < 0 ? 'color: var(--accent);' : ''}>{formatCLP(personalSpent)}</span>
            <span class="dash-budget-of">DE {formatCLP(personalIncome)}</span>
          </div>
          <div class="dash-budget-stats">
            <div class="dash-stat">
              <span class="dash-stat-label">RESTANTE</span>
              <span class="dash-stat-value" style={personalRemaining < 0 ? 'color: var(--accent);' : 'color: var(--success);'}>{formatCLP(personalRemaining)}</span>
            </div>
            <div class="dash-stat">
              <span class="dash-stat-label">USADO</span>
              <span class="dash-stat-value">{Math.round(personalPctRaw)}%</span>
            </div>
          </div>
        </div>
        <div class="dash-budget-bar" aria-label={`Uso del sueldo personal: ${Math.round(personalPctRaw)}%`}>
          {personalSegs.map((seg) =>
            <div class={`dash-bar-seg ${seg.filled ? 'dash-bar-seg-on' : ''}`} style={seg.filled ? `background: ${seg.color};` : ''} />
          )}
        </div>
        <a href="/finanzas/personales" class="dash-card-link">
          <span>VER FINANZAS PERSONALES</span>
          <TctIcon name="arrowRight" size={12} variant="dots" />
        </a>
      </div>
    )}

    <!-- BUDGET HERO -->
    <div class="dash-card dash-card-budget dot-grid-subtle">
      <div class="dash-card-header">
        <div class="dash-card-label">PRESUPUESTO SEMANAL</div>
        <span class="dash-week-label">{weekLabel}</span>
      </div>
      {budgetAmount > 0 ? (
        <>
          <div class="dash-budget-hero">
            <div class="dash-budget-spent">
              <span class="dash-budget-amount" style={budgetOverflow ? 'color: var(--accent);' : ''}>{formatCLP(weekExpenses)}</span>
              <span class="dash-budget-of">DE {formatCLP(budgetAmount)}</span>
            </div>
            <div class="dash-budget-stats">
              <div class="dash-stat">
                <span class="dash-stat-label">RESTANTE</span>
                <span class="dash-stat-value" style={remaining < 0 ? 'color: var(--accent);' : 'color: var(--success);'}>{formatCLP(remaining)}</span>
              </div>
              <div class="dash-stat">
                <span class="dash-stat-label">DIARIO AVG</span>
                <span class="dash-stat-value">{formatCLP(dailyAvg)}</span>
              </div>
            </div>
          </div>
          <div class="dash-budget-bar">
            {budgetSegs.map((seg) =>
              <div class={`dash-bar-seg ${seg.filled ? 'dash-bar-seg-on' : ''}`} style={seg.filled ? `background: ${seg.color};` : ''} />
            )}
          </div>
          <!-- Daily sparkline -->
          <div class="dash-sparkline">
            {dayNames.map(day => {
              const val = dailySpending[day];
              const pct = Math.max(4, (val / maxDaily) * 100);
              const isToday = dayNames[now.getDay() === 0 ? 6 : now.getDay() - 1] === day;
              return (
                <div class={`dash-spark-col ${isToday ? 'dash-spark-today' : ''}`}>
                  {val > 0 ? <span class="dash-spark-val">{Math.round(val / 1000)}k</span> : <span class="dash-spark-val-empty" />}
                  <div class="dash-spark-bar-wrap">
                    <div class="dash-spark-bar" style={`height: ${pct}%;`} />
                  </div>
                  <span class="dash-spark-label">{day}</span>
                </div>
              );
            })}
          </div>
        </>
      ) : budgetError ? (
        <div class="dash-error-msg" role="alert">[NO SE PUDO CARGAR EL PRESUPUESTO — RECARGA LA PÁGINA]</div>
      ) : (
        <div class="dash-empty-msg">[SIN PRESUPUESTO CONFIGURADO]</div>
      )}
      <a href="/finanzas" class="dash-card-link">
        <span>VER FINANZAS</span>
        <TctIcon name="arrowRight" size={12} variant="dots" />
      </a>
    </div>

    <!-- TODAY'S MEALS (bento row) -->
    <div class="dash-card dash-card-meals">
      <div class="dash-card-header">
        <div class="dash-card-label">COMIDAS DE HOY</div>
        <span class="dash-meal-count">{filledMeals}/{mealTypes.length}</span>
      </div>
      {mealsError && (
        <p class="dash-error-msg" role="alert">[NO SE PUDIERON CARGAR LAS COMIDAS — RECARGA LA PÁGINA]</p>
      )}
      <div class="dash-meals-grid">
        {mealTypes.map(mt => {
          const meal = todaysMeals[mt.name];
          const isCurrent = mt.name === currentMeal;
          return (
            <div class={`dash-meal-slot ${isCurrent ? 'dash-meal-current' : ''} ${meal ? '' : 'dash-meal-empty'}`}>
              <div class="dash-meal-slot-header">
                <span class="dash-meal-slot-type">{mt.name.toUpperCase()}</span>
                <span class="dash-meal-slot-tag">{MEAL_LABELS[mt.name]}</span>
              </div>
              <span class="dash-meal-slot-desc">{meal || 'Sin planificar'}</span>
            </div>
          );
        })}
      </div>
      <a href="/comidas" class="dash-card-link">
        <span>PLANIFICAR</span>
        <TctIcon name="arrowRight" size={12} variant="dots" />
      </a>
    </div>

    <!-- WEIGHT CARD -->
    <div class="dash-card dash-card-weight">
      <div class="dash-card-header">
        <div class="dash-card-label">MI PESO</div>
        <a href="/peso" class="dash-card-link">
          <span>VER PROGRESO</span>
          <TctIcon name="arrowRight" size={12} variant="dots" />
        </a>
      </div>
      {latestWeight ? (
        <div class="dash-weight-hero">
          <span class="dash-weight-value">{latestWeight.toFixed(1)}</span>
          <span class="dash-weight-unit">KG</span>
        </div>
      ) : weightError ? (
        <div class="dash-error-msg" role="alert">[NO SE PUDO CARGAR TU PESO — RECARGA LA PÁGINA]</div>
      ) : (
        <div class="dash-empty-msg">[SIN REGISTROS DE PESO]</div>
      )}
      <div class="dash-weight-today">
        <span class={`dash-weight-check ${todayHasMorning ? 'dash-weight-done' : ''}`}>
          <TctIcon name="sun" size={14} variant="dots" />
          {todayHasMorning ? <TctIcon name="check" size={13} variant="dots" /> : <span aria-hidden="true">—</span>}
        </span>
        <span class={`dash-weight-check ${todayHasNight ? 'dash-weight-done' : ''}`}>
          <TctIcon name="moon" size={14} variant="dots" />
          {todayHasNight ? <TctIcon name="check" size={13} variant="dots" /> : <span aria-hidden="true">—</span>}
        </span>
      </div>
    </div>

    <!-- RECENT EXPENSES -->
    <div class="dash-card">
      <div class="dash-card-header">
        <div class="dash-card-label">GASTOS RECIENTES</div>
        <a href="/finanzas" class="dash-card-link">
          <span>VER TODO</span>
          <TctIcon name="arrowRight" size={12} variant="dots" />
        </a>
      </div>
      <div class="dash-expense-list">
        {expensesError && (
          <p class="dash-error-msg" role="alert">[NO SE PUDIERON CARGAR LOS GASTOS — RECARGA LA PÁGINA]</p>
        )}
        {!expensesError && expenseLogsSerialized.length === 0 && (
          <p class="dash-empty-msg">[SIN GASTOS RECIENTES]</p>
        )}
        {expenseLogsSerialized.slice(0, 5).map((exp: any) => (
          <div class="dash-expense-row">
            <div class="dash-expense-info">
              <span class="dash-expense-name">
                {exp.items && exp.items.length > 0
                  ? exp.items.map((it: any) => it.name).join(', ')
                  : exp.description}
              </span>
              <span class="dash-expense-meta">{exp.userName} · {exp.date}</span>
            </div>
            <span class="dash-expense-amount">-{formatCLP(exp.amount)}</span>
          </div>
        ))}
      </div>
    </div>

    <!-- QUICK ACTIONS -->
    <div class="dash-actions">
      <a href="/peso" class="dash-card dash-card-action">
        <span class="dash-action-icon"><TctIcon name="scale" size={18} variant="dots" /></span>
        <span class="dash-action-label">REGISTRAR PESO</span>
        <span class="dash-action-arrow"><TctIcon name="arrowRight" size={16} variant="dots" /></span>
      </a>
      <a href="/finanzas" class="dash-card dash-card-action">
        <span class="dash-action-icon"><TctIcon name="dollarSign" size={18} variant="dots" /></span>
        <span class="dash-action-label">REGISTRAR GASTO</span>
        <span class="dash-action-arrow"><TctIcon name="arrowRight" size={16} variant="dots" /></span>
      </a>
    </div>
  </div>
</Layout>

<style>
  .dashboard {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  /* Greeting */
  .dash-greeting {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
  }

  .dash-greeting-left {
    display: flex;
    align-items: center;
    gap: var(--space-md);
  }

  .dash-greeting-avatar {
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
  }

  .dash-greeting-avatar-letter {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--surface);
    color: var(--text-secondary);
    font-size: 16px;
    font-family: var(--font-mono);
    flex-shrink: 0;
  }

  .dash-greeting-text-wrap {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
  }

  .dash-greeting-text {
    font-family: var(--font-display);
    font-size: var(--heading);
    color: var(--text-display);
    font-weight: 700;
  }

  .dash-greeting-date {
    font-family: var(--font-mono);
    font-size: var(--caption);
    letter-spacing: 0.1em;
    color: var(--text-secondary);
  }

  /* Card Base */
  .dash-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-compact);
    padding: var(--space-lg);
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .dash-card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .dash-card-label {
    font-family: var(--font-mono);
    font-size: var(--label);
    letter-spacing: 0.12em;
    color: var(--text-secondary);
    text-transform: uppercase;
  }

  .dash-card-link {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    min-height: 44px;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.1em;
    color: var(--text-secondary);
    text-decoration: none;
    transition: color var(--duration-micro) var(--ease-out);
    flex-shrink: 0;
  }

  .dash-card-link:hover {
    color: var(--text-display);
  }

  .dash-card-link svg {
    flex-shrink: 0;
    transition: transform var(--duration-micro) var(--ease-out);
  }

  .dash-card-link:hover svg {
    transform: translateX(2px);
  }

  .dash-week-label {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.08em;
    color: var(--text-disabled);
  }

  .dash-empty-msg {
    font-family: var(--font-mono);
    font-size: var(--body-sm);
    color: var(--text-disabled);
    padding: var(--space-lg) 0;
    text-align: center;
  }

  .dash-error-msg {
    font-family: var(--font-mono);
    font-size: var(--body-sm);
    color: var(--accent);
    padding: var(--space-lg) 0;
    text-align: center;
  }

  /* Budget Hero */
  .dash-card-budget,
  .dash-card-personal {
    background: var(--surface-raised);
  }

  .dash-budget-hero {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: var(--space-lg);
  }

  .dash-budget-spent {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
  }

  .dash-budget-amount {
    font-family: var(--font-display);
    font-size: var(--display-md);
    color: var(--text-display);
    font-weight: 700;
    line-height: 1;
  }

  .dash-budget-of {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--text-disabled);
    letter-spacing: 0.06em;
  }

  .dash-budget-stats {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    align-items: flex-end;
  }

  .dash-stat {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 1px;
  }

  .dash-stat-label {
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.1em;
    color: var(--text-disabled);
  }

