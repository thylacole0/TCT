---
import Layout from '../../layouts/Layout.astro';
import FinanzasPersonalesIsland from '../../components/islands/FinanzasPersonalesIsland';
import TctIcon from '../../components/icons/TctIcon';

const { user, accessToken } = Astro.locals;
if (!user || !accessToken) return Astro.redirect('/signin');
---

<Layout title="TCT — Finanzas Personales" currentPath="/finanzas/personales">
  <div class="fp-page-header">
    <a href="/finanzas" class="back-link"><TctIcon name="arrowLeft" size={14} /> FINANZAS</a>
  </div>
  <FinanzasPersonalesIsland client:load />
</Layout>

<style>
  .fp-page-header {
    margin-bottom: var(--space-lg);
  }
  .back-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    font-family: var(--font-mono);
    font-size: var(--label);
    letter-spacing: 0.06em;
    color: var(--text-secondary);
    text-decoration: none;
    transition: color var(--duration-micro) var(--ease-out);
  }
  .back-link:hover {
    color: var(--text-display);
  }
</style>
