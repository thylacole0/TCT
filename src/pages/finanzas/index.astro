---
import Layout from '../../layouts/Layout.astro';
import BudgetIsland from '../../components/islands/BudgetIsland';
import { createAuthClient } from '../../lib/supabase';
import { getMondayChile, getMonthStartChile, formatDateCL } from '../../lib/dates';

const { user, accessToken } = Astro.locals;
if (!user || !accessToken) return Astro.redirect('/signin');

const supabase = createAuthClient(accessToken);

// Current week calculation (Chile timezone) — for COMIDA (weekly)
const weekStart = getMondayChile();
const weekEnd = new Date(weekStart);
weekEnd.setDate(weekStart.getDate() + 6);
const weekStartStr = formatDateCL(weekStart);
const weekLabel = `${weekStart.toLocaleDateString('es-CL', { day: '2-digit', month: 'short' })} — ${weekEnd.toLocaleDateString('es-CL', { day: '2-digit', month: 'short' })}`.toUpperCase();

// Current month calculation (Chile timezone) — for ASEO (monthly)
const monthStart = getMonthStartChile();
const monthStartStr = formatDateCL(monthStart);
const monthLabel = monthStart.toLocaleDateString('es-CL', { month: 'long', year: 'numeric' }).toUpperCase();

// Parallel: budgets (comida weekly + aseo monthly)
const [comidaBudgetRes, aseoBudgetRes] = await Promise.all([
  supabase.from('budget_weeks').select('*').eq('week_start', weekStartStr).eq('budget_type', 'comida').single(),
  supabase.from('budget_weeks').select('*').eq('week_start', monthStartStr).eq('budget_type', 'aseo').single(),
]);

const currentBudget = comidaBudgetRes.data;
const aseoBudget = aseoBudgetRes.data;

// Expenses depend on budget
const comidaBudgetId = currentBudget?.id || '00000000-0000-0000-0000-000000000000';
const aseoBudgetId = aseoBudget?.id || '00000000-0000-0000-0000-000000000000';

const [comidaExpRes, aseoExpRes] = await Promise.all([
  supabase.from('expenses').select('*, profiles(display_name, avatar_url)').eq('budget_week_id', comidaBudgetId).order('expense_date', { ascending: false }),
  supabase.from('expenses').select('*, profiles(display_name, avatar_url)').eq('budget_week_id', aseoBudgetId).order('expense_date', { ascending: false }),
]);

const expenses = comidaExpRes.data || [];
const aseoExpenses = aseoExpRes.data || [];

// Fetch expense items for both
const allExpenseIds = [...expenses, ...aseoExpenses].map((e: any) => e.id);
const { data: expenseItems } = allExpenseIds.length > 0
  ? await supabase.from('expense_items').select('*').in('expense_id', allExpenseIds)
  : { data: [] };

// Serialize expenses helper
const serializeExpenses = (exps: any[]) => exps.map((e: any) => ({
  id: e.id,
  description: e.description,
  amount: Number(e.amount),
  category: e.category,
  expense_date: e.expense_date,
  user_name: e.profiles?.display_name || '',
  user_avatar: e.profiles?.avatar_url || '',
  items: (expenseItems || [])
    .filter((item: any) => item.expense_id === e.id)
    .map((item: any) => ({ name: item.name, quantity: item.quantity, unit_price: Number(item.unit_price) })),
}));

// ─── Comida data ───
const comidaTotalSpent = expenses.reduce((sum, e) => sum + Number(e.amount), 0) || 0;
const comidaBudgetAmount = currentBudget ? Number(currentBudget.budget_amount) : 0;

const comidaCategoryTotals: Record<string, number> = {};
expenses.forEach(e => {
  const cat = e.category || 'Otros';
  comidaCategoryTotals[cat] = (comidaCategoryTotals[cat] || 0) + Number(e.amount);
});

const dayNames = ['LU', 'MA', 'MI', 'JU', 'VI', 'SA', 'DO'];
const comidaDailySpending: Record<string, number> = {};
for (let i = 0; i < 7; i++) comidaDailySpending[dayNames[i]] = 0;
expenses.forEach(e => {
  const dow = new Date(e.expense_date).getDay();
  const dayIdx = dow === 0 ? 6 : dow - 1;
  comidaDailySpending[dayNames[dayIdx]] += Number(e.amount);
});

const comidaProductTotals: Record<string, number> = {};
(expenseItems || []).filter((item: any) => expenses.some((e: any) => e.id === item.expense_id)).forEach((item: any) => {
  const name = item.name || 'Sin nombre';
  comidaProductTotals[name] = (comidaProductTotals[name] || 0) + Number(item.quantity) * Number(item.unit_price);
});

// ─── Aseo data ───
const aseoTotalSpent = aseoExpenses.reduce((sum, e) => sum + Number(e.amount), 0) || 0;
const aseoBudgetAmount = aseoBudget ? Number(aseoBudget.budget_amount) : 0;

const aseoCategoryTotals: Record<string, number> = {};
aseoExpenses.forEach(e => {
  const cat = e.category || 'Otros';
  aseoCategoryTotals[cat] = (aseoCategoryTotals[cat] || 0) + Number(e.amount);
});

const aseoDailySpending: Record<string, number> = {};
for (let i = 0; i < 7; i++) aseoDailySpending[dayNames[i]] = 0;
aseoExpenses.forEach(e => {
  const dow = new Date(e.expense_date).getDay();
  const dayIdx = dow === 0 ? 6 : dow - 1;
  aseoDailySpending[dayNames[dayIdx]] += Number(e.amount);
});

const aseoProductTotals: Record<string, number> = {};
(expenseItems || []).filter((item: any) => aseoExpenses.some((e: any) => e.id === item.expense_id)).forEach((item: any) => {
  const name = item.name || 'Sin nombre';
  aseoProductTotals[name] = (aseoProductTotals[name] || 0) + Number(item.quantity) * Number(item.unit_price);
});

const isReadOnly = Astro.locals.userRole === 'admin';
---

<Layout title="TCT — Finanzas" currentPath="/finanzas">
  <BudgetIsland
    client:load
    weekLabel={weekLabel}
    aseoLabel={monthLabel}
    comida={{
      budgetWeekId: currentBudget?.id,
      budgetAmount: comidaBudgetAmount,
      totalSpent: comidaTotalSpent,
      expenses: serializeExpenses(expenses),
      categories: ['Supermercado', 'Feria', 'Delivery', 'Otro'],
      dailySpending: comidaDailySpending,
      categoryTotals: Object.entries(comidaCategoryTotals).sort((a, b) => b[1] - a[1]),
      productTotals: Object.entries(comidaProductTotals).sort((a, b) => b[1] - a[1]).slice(0, 10),
    }}
    aseo={{
      budgetWeekId: aseoBudget?.id,
      budgetAmount: aseoBudgetAmount,
      totalSpent: aseoTotalSpent,
      expenses: serializeExpenses(aseoExpenses),
      categories: ['Supermercado', 'Ferretería', 'Online', 'Otro'],
      dailySpending: aseoDailySpending,
      categoryTotals: Object.entries(aseoCategoryTotals).sort((a, b) => b[1] - a[1]),
      productTotals: Object.entries(aseoProductTotals).sort((a, b) => b[1] - a[1]).slice(0, 10),
    }}
    isReadOnly={isReadOnly}
  />
</Layout>
